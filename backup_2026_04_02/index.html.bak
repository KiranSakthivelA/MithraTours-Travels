    <script src="js/cities.js?v=4"></script>

    <!-- Firebase SDK / Main JS -->
    <script type="module" src="js/main.js?v=17"></script>
    <script>
        // Main Form Trip Type Toggle
        document.querySelectorAll('input[name="mb-trip-type"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                const endDateGroup = document.getElementById('mb-end-date-group');
                if (e.target.value === 'Round Trip') {
                    if (endDateGroup) endDateGroup.style.display = 'block';
                    const endDateInput = document.getElementById('mb-end-date');
                    if (endDateInput) endDateInput.required = true;
                } else {
                    if (endDateGroup) endDateGroup.style.display = 'none';
                    const endDateInput = document.getElementById('mb-end-date');
                    if (endDateInput) endDateInput.required = false;
                }
            });
        });

        // Hero Form Trip Type Toggle (if present)
        document.querySelectorAll('input[name="qb-trip-type"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                const endDateGroup = document.getElementById('qb-end-date-group');
                const endDateInput = document.getElementById('qb-end-date');
                if (e.target.value === 'Round Trip') {
                    if (endDateGroup) endDateGroup.style.display = 'block';
                    if (endDateInput) endDateInput.required = true;
                } else {
                    if (endDateGroup) endDateGroup.style.display = 'none';
                    if (endDateInput) endDateInput.required = false;
                }
            });
        });

        // Robust Date Initialization
        window.addEventListener('load', function() {
            setTimeout(function() {
                const now = new Date();
                const yyyy = now.getFullYear();
                const mm = String(now.getMonth() + 1).padStart(2, '0');
                const dd = String(now.getDate()).padStart(2, '0');
                const todayStr = `${yyyy}-${mm}-${dd}`;
                
                ['qb-date', 'mb-date', 'mb-end-date'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        el.value = todayStr;
                        el.setAttribute('value', todayStr);
                    }
                });
            }, 100);
        });
    </script>
    <script src="js/booking.js?v=10"></script>
