<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KPS Tours & Travels | Premium Cab Services</title>
    <title>KPS Tours & Travels | Premium Cab Services</title>
    <meta name="description"
        content="Book KPS Tours & Travels Service All Over Tamilnadu, Kerala, Karnataka, Andhra and Telangana. One way, round trip, airport transfers, and tour packages.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="stylesheet" href="css/brand.css?v=11">
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyAdK3ME-SLn3S89x7fA3W04_X8TyJ9Us2I&libraries=places,geometry&callback=Function.prototype" async></script>
</head>

<body>

    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <a href="#" class="logo">
                <img src="Assets/KPS_LOGO_PNG.png" alt="KPS Travels" style="height: 48px; width: auto;">
            </a>
            <div class="nav-links" id="nav-links">
                <a href="index.html">Home</a>
                <a href="our-fleet.html">Our Fleet</a>
                <a href="routes.html">Routes</a>
                <a href="services.html">Services</a>
                <a href="feedback.html">Feedback</a>
                <a href="index.html#home" class="btn-primary nav-btn">Book Now</a>
            </div>
            <div class="menu-toggle" id="mobile-menu">
                <i class="fa-solid fa-bars"></i>
            </div>
        </div>
    </nav>


    <section id="home" class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-container">
            <div class="hero-content">
                <h1 class="animate-up">Premium Rides Across<br><span class="highlight">South India</span></h1>
                <p class="animate-up delay-1">Book <span class="highlight-alt">KPS Tours & Travels</span> Service All
                    Over Tamilnadu, Kerala, Karnataka, Andhra and Telangana. One-Way, Round-Trip & All Tour Packages.
                </p>
                <div class="hero-actions animate-up delay-2">
                    <a href="#home" class="btn-primary" style="min-width:170px;"><i class="fa-solid fa-calendar-check"></i> Plan Journey</a>
                    <a href="tel:+919442173548" class="btn-secondary" style="min-width:170px;"><i class="fa-solid fa-phone"></i> +91 94421 73548</a>
                </div>
            </div>
            <!-- Quick Quote Booking Form -->
            <div class="hero-form-wrapper animate-in-right">
                <div class="hero-form hero-booking-container">
                    <h3 class="hero-form-title"><i class="fa-solid fa-bolt" style="color:#00B4D8;"></i> Quick Estimate</h3>

                    <!-- Trip Toggle -->
                    <div style="margin-bottom:1.4rem; display:flex; justify-content:center;">
                        <div class="trip-toggle">
                            <input type="radio" name="qb-trip-type" id="qb-one-way-hero" value="One Way" checked>
                            <label for="qb-one-way-hero">One Way</label>
                            <input type="radio" name="qb-trip-type" id="qb-round-trip-hero" value="Round Trip">
                            <label for="qb-round-trip-hero">Round Trip</label>
                        </div>
                    </div>

                    <!-- Date & Time -->
                    <div class="form-row" style="margin-bottom:1.1rem;">
                        <div class="field-container">
                            <input type="date" id="qb-date" class="booking-field-input" required>
                        </div>
                        <div class="field-container">
                            <input type="time" id="qb-time" class="booking-field-input" required>
                        </div>
                    </div>

                    <!-- Return date (Round Trip only) -->
                    <div id="qb-end-date-group" style="display:none; margin-bottom:1.1rem;">
                        <input type="date" id="qb-end-date" class="booking-field-input" placeholder="Return Date">
                    </div>

                    <!-- Pickup & Drop -->
                    <div class="field-container" style="margin-bottom:1.1rem;">
                        <input type="text" id="qb-pickup" class="booking-field-input" placeholder="Pickup City / Location" required>
                    </div>
                    <div class="field-container" style="margin-bottom:1.4rem;">
                        <input type="text" id="qb-drop" class="booking-field-input" placeholder="Drop City / Location" required>
                    </div>

                    <!-- Error -->
                    <div id="qb-error" style="color:#ff6b6b; font-size:0.85rem; margin-bottom:0.8rem; display:none; text-align:center;"></div>
                    <!-- Return date + Days (Round Trip only) -->
                    <div id="qb-end-date-group" style="display:none; margin-bottom:1.1rem;">
                        <div class="form-row">
                            <div class="field-container">
                                <input type="date" id="qb-end-date" class="booking-field-input" placeholder="Return Date">
                            </div>
                            <div class="field-container" style="position:relative;">
                                <input type="number" id="qb-days" class="booking-field-input" min="1" max="30" value="1" placeholder="Days">
                                <span style="position:absolute;right:0.8rem;top:50%;transform:translateY(-50%);font-size:0.75rem;color:#94a3b8;pointer-events:none;">days</span>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden compat elements -->
                    <div style="display:none;">
                        <select id="qb-car"><option value="Sedan">Sedan</option></select>
                        <div id="qb-days-group"></div>
                        <div id="qb-estimate-box"><span id="qb-distance"></span><span id="qb-fare"></span></div>
                        <button id="qb-btn-confirm"></button>
                    </div>

                    <!-- Estimate Button -->
                    <button type="button" id="qb-btn-estimate" class="btn-primary full-width" style="font-size:1rem; padding:0.9rem;">
                        <i class="fa-solid fa-calculator"></i> Get Estimate
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ======= FARE COMPARISON MODAL ======= -->
    <div id="fare-modal" style="display:none; position:fixed; inset:0; background:rgba(3,4,94,0.75); backdrop-filter:blur(10px); z-index:9999; overflow-y:auto; padding:1rem;">
        <div class="fm-modal-body" style="max-width:900px; margin:2rem auto; background:#fff; border-radius:24px; box-shadow:0 30px 80px rgba(0,0,0,0.3); overflow:hidden; animation:fadeUp 0.4s cubic-bezier(0.34,1.56,0.64,1);">

            <!-- Modal Header -->
            <div style="background:linear-gradient(135deg,#03045E,#0077B6); padding:1.6rem 2rem; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <h2 style="color:#fff; font-size:1.4rem; margin:0; font-weight:800;">Available Vehicles</h2>
                    <p id="fm-route-label" style="color:rgba(255,255,255,0.75); margin:0.35rem 0 0; font-size:0.9rem; font-weight:500;"></p>
                </div>
                <button onclick="closeFareModal()" style="background:rgba(255,255,255,0.2); border:2px solid rgba(255,255,255,0.3); color:#fff; width:38px; height:38px; border-radius:50%; font-size:1.2rem; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.35)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'">✕</button>
            </div>

            <!-- Info Bar -->
            <div style="background:#f8fafc; border-bottom:1px solid #e2e8f0; padding:0.8rem 2rem; display:flex; gap:2rem; flex-wrap:wrap; align-items:center;">
                <span style="font-size:0.88rem; color:#475569;"><i class="fa-solid fa-road" style="color:#0077B6; margin-right:5px;"></i>Distance: <strong id="fm-distance">—</strong></span>
                <span style="font-size:0.88rem; color:#475569;"><i class="fa-solid fa-clock" style="color:#0077B6; margin-right:5px;"></i>Duration: <strong id="fm-duration">—</strong></span>
                <span style="font-size:0.88rem; color:#475569;"><i class="fa-solid fa-arrows-left-right" style="color:#0077B6; margin-right:5px;"></i>Trip: <strong id="fm-trip-type">One Way</strong></span>
                <span style="font-size:0.73rem; color:#94a3b8; margin-left:auto;"><i class="fa-solid fa-circle-info"></i> Inclusive of driver allowance</span>
            </div>

            <!-- Vehicle Cards -->
            <div id="fm-cards" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:1.4rem; padding:1.6rem 2rem 2rem;"></div>

            <!-- Disclaimer -->
            <div style="padding:0 2rem 1.4rem; text-align:center;">
                <p style="font-size:0.78rem; color:#94a3b8; margin:0;">* Tolls, parking &amp; hill charges extra. Night charges (10 PM – 6 AM) may apply. Actual fare may vary.</p>
            </div>
        </div>
    </div>

    <!-- Fleet Section -->
    <section id="fleet" class="fleet">
        <div class="section-header reveal">
            <h2>Choose Your Ride</h2>
            <div class="header-line"></div>
            <p>Well-maintained, clean vehicles for every budget</p>
        </div>
        <div class="fleet-grid">
            <!-- Sedan -->
            <div class="fleet-card reveal">
                <div class="fleet-image type-sedan" style="position:relative; overflow:hidden; padding:0; height:180px;">
                    <img src="Assets/car_sedan.png" alt="Sedan" style="width:100%; height:100%; object-fit:cover; object-position:center;" onerror="this.parentElement.innerHTML='<i class=&quot;fa-solid fa-car&quot; style=&quot;font-size:3.5rem; color:rgba(255,255,255,0.6);&quot;></i>'">
                    <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,0.25) 0%,transparent 65%);"></div>
                </div>
                <div class="fleet-info">
                    <h3>Sedan</h3>
                    <p>Perfect for small families and business trips. Economical and comfortable.</p>
                    <table
                        style="width:100%; background:#f8fafc; padding:12px; border-left:4px solid var(--brand-cyan); border-collapse:collapse; margin-bottom:15px; font-size:0.88rem; border-radius: 8px;">
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Base Charge (One Way)</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹14 / km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Round Trip Rate</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹13 / km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">One Way Minimum</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>130 Km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Round Trip Minimum</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>250 Km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Driver Allowance</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹400</strong></td>
                        </tr>
                    </table>
                    <div class="fleet-specs" style="margin-bottom:15px;">
                        <span><i class="fa-solid fa-user"></i> 4 Seats</span>
                        <span><i class="fa-solid fa-suitcase"></i> 2 Bags</span>
                    </div>
                    <div class="fleet-actions">
                        <a href="#home" class="btn-primary full-width book-btn" data-car="Sedan">Book Now</a>
                    </div>
                </div>
            </div>
            <!-- SUV -->
            <div class="fleet-card reveal delay-1">
                <div class="fleet-image type-suv" style="position:relative; overflow:hidden; padding:0; height:180px;">
                    <img src="Assets/car_suv.png" alt="SUV" style="width:100%; height:100%; object-fit:cover; object-position:center;" onerror="this.parentElement.innerHTML='<i class=&quot;fa-solid fa-truck-pickup&quot; style=&quot;font-size:3.5rem; color:rgba(255,255,255,0.6);&quot;></i>'">
                    <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,0.25) 0%,transparent 65%);"></div>
                </div>
                <div class="fleet-info">
                    <h3>SUV</h3>
                    <p>Ideal for family trips and groups. Spacious with extra luggage capacity.</p>
                    <table
                        style="width:100%; background:#f8fafc; padding:12px; border-left:4px solid var(--brand-cyan); border-collapse:collapse; margin-bottom:15px; font-size:0.88rem; border-radius: 8px;">
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Base Charge (One Way)</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹19 / km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Round Trip Rate</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹18 / km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">One Way Minimum</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>130 Km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Round Trip Minimum</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>250 Km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Driver Allowance</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹400</strong></td>
                        </tr>
                    </table>
                    <div class="fleet-specs" style="margin-bottom:15px;">
                        <span><i class="fa-solid fa-user"></i> 7 Seats</span>
                        <span><i class="fa-solid fa-suitcase"></i> 4 Bags</span>
                    </div>
                    <div class="fleet-actions">
                        <a href="#home" class="btn-primary full-width book-btn" data-car="SUV">Book Now</a>
                    </div>
                </div>
            </div>
            <!-- Innova Crysta -->
            <div class="fleet-card reveal delay-2">
                <div class="fleet-image type-innova type-muv" style="position:relative; overflow:hidden; padding:0; height:180px;">
                    <img src="Assets/car_innova.png" alt="Innova Crysta" style="width:100%; height:100%; object-fit:cover; object-position:center; transform:scaleX(-1);" onerror="this.parentElement.innerHTML='<i class=&quot;fa-solid fa-shuttle-van&quot; style=&quot;font-size:3.5rem; color:rgba(255,255,255,0.6);&quot;></i>'">
                    <div style="position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,0.25) 0%,transparent 65%);"></div>
                </div>
                <div class="fleet-info">
                    <h3>Innova Crysta</h3>
                    <p>The gold standard for long-distance luxury. Superior comfort and safety.</p>
                    <table
                        style="width:100%; background:#f8fafc; padding:12px; border-left:4px solid var(--brand-cyan); border-collapse:collapse; margin-bottom:15px; font-size:0.88rem; border-radius: 8px;">
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Base Charge (One Way)</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹21 / km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Round Trip Rate</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹20 / km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">One Way Minimum</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>130 Km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Round Trip Minimum</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>250 Km</strong></td>
                        </tr>
                        <tr>
                            <td style="padding:4px 8px; color:#555;">Driver Allowance</td>
                            <td style="padding:4px 8px; text-align:right;"><strong>₹400</strong></td>
                        </tr>
                    </table>
                    <div class="fleet-specs" style="margin-bottom:15px;">
                        <span><i class="fa-solid fa-user"></i> 7 Seats</span>
                        <span><i class="fa-solid fa-suitcase"></i> 4 Bags</span>
                    </div>
                    <div class="fleet-actions">
                        <a href="#home" class="btn-primary full-width book-btn" data-car="MUV">Book Now</a>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- Routes Section -->
    <section id="routes" class="contact-section">
        <div class="contact-container" style="display:block; max-width: 1200px; margin: 0 auto;">
            <div class="routes-info reveal text-center">
                <span class="breadcrumb" style="display:block; margin-bottom:1rem;">Our Service Network</span>
                <h2 style="font-size:3rem; margin-bottom:1rem;">South India’s Premier Travel Network</h2>
                <p class="coverage-desc" style="max-width:700px; margin: 0 auto 4rem;">Experience seamless inter-state
                    travel across 5 major states with our professional chauffeured services and a network covering over
                    100+ routes.</p>

                <div class="states-grid">
                    <div class="state-card reveal">
                        <i class="fa-solid fa-landmark state-icon"></i>
                        <h3>Tamil Nadu</h3>
                        <p>Core Service Area</p>
                    </div>
                    <div class="state-card reveal delay-1">
                        <i class="fa-solid fa-mountain-sun state-icon"></i>
                        <h3>Kerala</h3>
                        <p>God's Own Country</p>
                    </div>
                    <div class="state-card reveal delay-2">
                        <i class="fa-solid fa-building-columns state-icon"></i>
                        <h3>Karnataka</h3>
                        <p>Silicon Hub & Heritage</p>
                    </div>
                    <div class="state-card reveal delay-1">
                        <i class="fa-solid fa-place-of-worship state-icon"></i>
                        <h3>Andhra</h3>
                        <p>Spiritual & Coastal</p>
                    </div>
                    <div class="state-card reveal delay-2">
                        <i class="fa-solid fa-city state-icon"></i>
                        <h3>Telangana</h3>
                        <p>Modern Metropolis</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Custom Quote Banner -->
    <section class="cta-premium-banner reveal">
        <div class="cta-flex">
            <div class="cta-text">
                <h2>Your Premier Inter-State Travel Partner</h2>
                <p>Reliable, comfortable, and affordable service across Tamil Nadu, Kerala, Karnataka, Andhra &
                    Telangana. Whether it's a one-way drop or a round trip, we've got you covered.</p>
            </div>
            <div class="cta-button-side">
                <a href="tel:+919442173548" class="btn-premium-cta">
                    <i class="fa-solid fa-phone"></i>
                    Get Custom Quote (+91 94421 73548)
                </a>
                <p style="margin-top:1.2rem; font-size:1rem; color:var(--brand-cyan); font-weight:800; display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-bolt"></i> Instant Booking Available
                </p>
            </div>
        </div>
    </section>
    <!-- Popular Cities -->
    <section id="popular-cities" class="popular-cities-section">
        <div class="section-header reveal">
            <h2>Explore Popular Cities</h2>
            <div class="header-line"></div>
        </div>
        
        <div class="swiper citiesSwiper reveal">
            <div class="swiper-wrapper" id="cities-swiper-wrapper">
                <!-- Dynamically populated via JS -->
            </div>
            <!-- Navigation -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination"></div>
        </div>
    </section>

    <!-- Popular Routes -->
    <section id="popular-routes" class="popular-routes-section">
        <div class="section-header reveal">
            <h2>Trending Travel Routes</h2>
            <div class="header-line"></div>
        </div>

        <div class="swiper routesSwiper reveal">
            <div class="swiper-wrapper" id="routes-swiper-wrapper">
                <!-- Dynamically populated via JS -->
            </div>
            <!-- Navigation -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    </section>

    <!-- Services Overview -->
    <section id="services" class="services">
        <div class="section-header reveal">
            <h2>Our Premium Services</h2>
            <div class="header-line"></div>
            <p>Trusted door-to-door outstation transportation</p>
        </div>
        <div class="services-grid">
            <div class="service-card reveal">
                <div class="icon-box"><i class="fa-solid fa-car-on"></i></div>
                <h3>Outstation Taxi</h3>
                <p>Door-to-Door comfortable long-distance travel for your outstation journeys with experienced drivers.
                </p>
            </div>
            <div class="service-card reveal delay-1">
                <div class="icon-box"><i class="fa-solid fa-route"></i></div>
                <h3>One-Way Drops</h3>
                <p>Flexible and affordable one-way drop taxis matching your specific needs and budget.</p>
            </div>
            <div class="service-card reveal delay-2">
                <div class="icon-box"><i class="fa-solid fa-plane-departure"></i></div>
                <h3>Airport Transfers</h3>
                <p>Punctual and hassle-free airport pickups and drop-offs. Never miss a flight with our prompt service.
                </p>
            </div>
        </div>
    </section>

    <!-- Transparent Pricing -->
    <section id="pricing" class="pricing-section">
        <div class="section-header reveal">
            <h2><i class="fa-solid fa-tags" style="color:var(--accent-color);"></i> Transparent Pricing</h2>
            <div class="header-line"></div>
        </div>
        <div class="pricing-container reveal">
            <div class="pricing-table-wrap">
                <table class="pricing-table">
                    <thead>
                        <tr>
                            <th colspan="3">Service Pricing Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><strong>Base Fare</strong></td>
                            <td><span class="price-chip">₹ 14 / km</span></td>
                            <td class="price-desc">Standard per-kilometer fare applied across most routes with no hidden
                                charges.</td>
                        </tr>
                        <tr>
                            <td><strong>One-Way Fare</strong></td>
                            <td><span class="price-chip">Min. 130 km</span></td>
                            <td class="price-desc">Affordable pricing for one-way drop taxi services with no return
                                fare.</td>
                        </tr>
                        <tr>
                            <td><strong>Round-Trip Fare</strong></td>
                            <td><span class="price-chip">Min. 250 km</span></td>
                            <td class="price-desc">Economical per-kilometer rates for round-trip outstation travel.</td>
                        </tr>
                        <tr>
                            <td><strong>Custom Routes</strong></td>
                            <td><span class="price-chip btn-support" style="cursor:pointer;"
                                    onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">Call
                                    Support</span></td>
                            <td class="price-desc">For routes not listed online, call us directly for instant
                                assistance.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Wide Service Coverage -->
    <section id="coverage" class="wide-coverage-section reveal" style="margin-top:0;">
        <div class="coverage-container">
            <h2><i class="fa-solid fa-map-location-dot" style="color:var(--accent-color);"></i> Wide Service Coverage
            </h2>
            <ul class="coverage-list">
                <li><i class="fa-solid fa-circle-check"></i>
                    <div><strong>Tamil Nadu Coverage:</strong> All major cities and districts.</div>
                </li>
                <li><i class="fa-solid fa-circle-check"></i>
                    <div><strong>Inter-State Travel:</strong> Service All Over Tamilnadu, Kerala, Karnataka, Andhra and
                        Telangana Oneway And Round Trip And Airport Transfers And All Tour Packages.</div>
                </li>
                <li><i class="fa-solid fa-circle-check"></i>
                    <div><strong>100+ Routes:</strong> Popular and custom outstation routes covered.</div>
                </li>
            </ul>
        </div>
    </section>

    <!-- Booking / Contact Section -->
    <section id="contact" class="contact-section">
        <div class="contact-container">
                    <div class="full-booking-form reveal delay-1">
                        <div class="section-header">
                            <h2>Plan Your Journey</h2>
                            <div class="header-line"></div>
                            <p>Fill in details and instantly connect via WhatsApp.</p>
                        </div>

                        <form id="main-booking-form" class="modern-form">
                             <!-- Trip Type Toggle -->
                             <div style="margin-bottom:1.5rem; display:flex; justify-content:center;">
                                 <div class="trip-toggle">
                                     <input type="radio" name="mb-trip-type" id="mb-one-way" value="One Way" checked>
                                     <label for="mb-one-way">One Way</label>
                                     <input type="radio" name="mb-trip-type" id="mb-round-trip" value="Round Trip">
                                     <label for="mb-round-trip">Round Trip</label>
                                 </div>
                             </div>

                             <!-- Hidden elements for JS compatibility -->
                             <div style="display:none;">
                                 <select id="mb-days"></select>
                             </div>

                            <div class="form-row-modern">
                                <div class="form-group-modern">
                                    <label class="form-label-top">Full Name</label>
                                    <input type="text" id="mb-name" placeholder="John Doe" required>
                                </div>
                                <div class="form-group-modern">
                                    <label class="form-label-top">Phone</label>
                                    <input type="tel" id="mb-phone" placeholder="Your Phone Number" required>
                                </div>
                            </div>

                            <div class="form-row-modern">
                                <div class="form-group-modern">
                                    <label class="form-label-top">Pickup City</label>
                                    <input type="text" id="mb-pickup" placeholder="E.g., Coimbatore" list="city-list" autocomplete="off" required>
                                </div>
                                <div class="form-group-modern">
                                    <label class="form-label-top">Drop City / Tour Place</label>
                                    <input type="text" id="mb-drop" placeholder="E.g., Bangalore" list="city-list" autocomplete="off" required>
                                </div>
                            </div>

                            <div class="form-row-modern">
                                <div class="form-group-modern">
                                    <label class="form-label-top">Travel Start Date</label>
                                    <input type="date" id="mb-date" required>
                                </div>
                                <div class="form-group-modern" id="mb-end-date-group" style="display:none;">
                                    <label class="form-label-top">Travel End Date</label>
                                    <input type="date" id="mb-end-date">
                                </div>
                                <div class="form-group-modern">
                                    <label class="form-label-top">Pickup Time</label>
                                    <input type="time" id="mb-time" required>
                                </div>
                            </div>

                            <div id="mb-estimate-box" class="estimate-box" style="display:none; margin-bottom:2rem; padding:1.5rem; background:#f8fafc; border-radius:14px; border:1.5px solid #f1f5f9;">
                                <div style="display:flex; justify-content:space-between; color:#64748b; font-size:0.95rem;">
                                    <span>Calculated Distance:</span> <span id="mb-distance" style="font-weight:700; color:#1e293b;">0 km</span>
                                </div>
                                <div style="display:flex; justify-content:space-between; color:var(--accent-color); font-weight:800; font-size:1.4rem; margin-top:0.75rem; border-top:1px solid #f1f5f9; padding-top:0.75rem;">
                                    <span>Estimated Fare:</span> <span id="mb-fare">₹0</span>
                                </div>
                                <div id="mb-error" style="color:#ff4d4d; font-size:0.9rem; margin-top:0.75rem; display:none;"></div>
                            </div>

                            <div class="form-group-modern full-width" style="margin-bottom: 2rem;">
                                <label class="form-label-top">Vehicle Type</label>
                                <select id="mb-car" required>
                                    <option value="Sedan" selected>Sedan</option>
                                    <option value="SUV">SUV</option>
                                    <option value="MUV">MUV / Innova</option>
                                </select>
                            </div>

                            <div class="form-group-modern full-width">
                                <label class="form-label-top">Special Requirements (Optional)</label>
                                <textarea id="mb-message" placeholder="Any specific needs..."></textarea>
                            </div>

                            <div style="text-align: center;">
                                <button type="button" id="mb-btn-estimate" class="btn-primary full-width">
                                    Get Estimate <i class="fa-solid fa-calculator"></i>
                                </button>
                                <button type="submit" id="mb-btn-confirm" class="btn-primary full-width" style="display:none;">
                                    Confirm Booking Request <i class="fa-brands fa-whatsapp"></i>
                                </button>
                            </div>

                            <!-- Hidden proxy elements to prevent main.js from crashing -->
                            <div style="display:none;">
                                <div id="mb-error"></div>
                                <button type="button" id="mb-btn-estimate"></button>
                                <button type="button" id="mb-btn-confirm"></button>
                            </div>
                        </form>
                    </div>
    </section>
    <!-- Feedback Section -->
    <section id="feedback" class="feedback-section">
        <div class="section-header reveal">
            <h2>Customer Feedback</h2>
            <div class="header-line"></div>
            <p>What our travelers say about us</p>
        </div>
        <div class="feedback-container">
            <!-- Submission Form -->
            <div class="feedback-form-card reveal">
                <h3>Leave a Review</h3>
                <form id="feedback-form" class="modern-feedback-form">
                    <div class="form-group-modern" style="margin-bottom: 1.5rem;">
                        <label class="form-label-top">Full Name</label>
                        <input type="text" id="fb-name" placeholder="E.g. Ramesh Kumar" required>
                    </div>
                    <div class="form-group-modern" style="margin-bottom: 1.5rem;">
                        <label class="form-label-top">Rating</label>
                        <select id="fb-rating" style="width: 100%;" required>
                            <option value="5">⭐⭐⭐⭐⭐ (5/5 Excellence)</option>
                            <option value="4">⭐⭐⭐⭐ (4/5 Very Good)</option>
                            <option value="3">⭐⭐⭐ (3/5 Good)</option>
                            <option value="2">⭐⭐ (2/5 Average)</option>
                            <option value="1">⭐ (1/5 Poor)</option>
                        </select>
                    </div>
                    <div class="form-group-modern" style="margin-bottom: 2rem;">
                        <label class="form-label-top">Share Your Experience</label>
                        <textarea id="fb-message" placeholder="How was your ride with KPS?" required></textarea>
                    </div>
                    <button type="submit" id="fb-btn-submit" class="btn-primary w-100">
                        Post My Review <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>

            <!-- Display Feedbacks -->
            <div class="feedback-list reveal delay-1" id="feedbacks-container">
                <div class="text-center" style="padding: 2rem; color: var(--text-secondary);">
                    <i class="fa-solid fa-spinner fa-spin"></i> Loading reviews...
                </div>
            </div>
        </div>
    </section>

    <!-- Ready on Your Next Trip CTA -->
    <section class="cta-premium-banner reveal">
        <div class="cta-flex">
            <div class="cta-text">
