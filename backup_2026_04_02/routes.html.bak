<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Routes We Cover | KPS Tours & Travels</title>
    <meta name="description" content="Explore 100+ routes covered by KPS Tours & Travels across Tamil Nadu, Kerala, Karnataka, Andhra and Telangana. Book your drop taxi today.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
    <link rel="stylesheet" href="css/brand.css?v=11">
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar" id="navbar">
        <div class="nav-container">
            <a href="index.html" class="logo">
                <img src="Assets/KPS_LOGO_PNG.png" alt="KPS Travels" style="height:52px; width:auto;">
            </a>
            <div class="nav-links" id="nav-links">
                <a href="index.html">Home</a>
                <a href="our-fleet.html">Our Fleet</a>
                <a href="routes.html" class="active">Routes</a>
                <a href="services.html">Services</a>
                <a href="feedback.html">Feedback</a>
                <a href="index.html#home" class="btn-primary nav-btn">Book Now</a>
            </div>
            <div class="menu-toggle" id="mobile-menu">
                <i class="fa-solid fa-bars"></i>
            </div>
        </div>
    </nav>

    <!-- Sub-page Hero -->
    <section class="sub-hero">
        <div class="hero-overlay"></div>
        <div class="sub-hero-content reveal">
            <p class="breadcrumb">Home &bull; Routes</p>
            <h1>Routes We Cover</h1>
            <p style="color:rgba(255,255,255,0.8); font-size:1.1rem; margin-top:0.8rem; font-weight:400;">
                100+ routes across South India with point-to-point service
            </p>
            <div class="badges-container" style="justify-content:center; margin-top:1.5rem; flex-wrap:wrap;">
                <span class="coverage-badge">Tamil Nadu</span>
                <span class="coverage-badge">Kerala</span>
                <span class="coverage-badge">Karnataka</span>
                <span class="coverage-badge">Andhra</span>
                <span class="coverage-badge">Telangana</span>
            </div>
        </div>
    </section>

    <!-- States Coverage Strip -->
    <section style="padding:2.5rem 2rem; background:#fff; border-bottom:1px solid #f1f5f9;">
        <div style="max-width:1100px; margin:0 auto; display:flex; flex-wrap:wrap; justify-content:center; gap:0;">

            <div class="state-strip-item reveal">
                <i class="fa-solid fa-building-columns"></i>
                <strong>Tamil Nadu</strong>
                <span>Core Service Area</span>
            </div>

            <div class="state-strip-item reveal delay-1">
                <i class="fa-solid fa-mountain-sun"></i>
                <strong>Kerala</strong>
                <span>God's Own Country</span>
            </div>

            <div class="state-strip-item reveal delay-2">
                <i class="fa-solid fa-building-columns"></i>
                <strong>Karnataka</strong>
                <span>Silicon Hub &amp; Heritage</span>
            </div>

            <div class="state-strip-item reveal">
                <i class="fa-solid fa-place-of-worship"></i>
                <strong>Andhra</strong>
                <span>Spiritual &amp; Coastal</span>
            </div>

            <div class="state-strip-item reveal delay-1">
                <i class="fa-solid fa-city"></i>
                <strong>Telangana</strong>
                <span>Modern Metropolis</span>
            </div>

        </div>
    </section>

    <!-- Popular Cities Swiper -->
    <section id="popular-cities" class="popular-cities-section">
        <div class="section-header reveal">
            <h2>Explore Popular Cities</h2>
            <div class="header-line"></div>
            <p>We cover the most sought-after destinations across South India</p>
        </div>

        <div class="swiper citiesSwiper reveal">
            <div class="swiper-wrapper" id="cities-swiper-wrapper">
                <!-- Dynamically populated via main.js -->
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-pagination"></div>
        </div>
    </section>

    <!-- Popular Routes Swiper -->
    <section id="popular-routes" class="popular-routes-section">
        <div class="section-header reveal">
            <h2>Trending Travel Routes</h2>
            <div class="header-line"></div>
            <p>Frequently booked routes from Coimbatore and nearby cities</p>
        </div>

        <div class="swiper routesSwiper reveal">
            <div class="swiper-wrapper" id="routes-swiper-wrapper">
                <!-- Dynamically populated via main.js -->
            </div>
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>
    </section>

    <!-- CTA Banner -->
    <section class="cta-premium-banner reveal">
        <div class="cta-flex">
            <div class="cta-text">
                <h2 style="color:#fff !important;">Your Premier Inter-State Travel Partner</h2>
                <p style="color:#a8b2d1 !important;">Reliable, comfortable, and affordable service across Tamil Nadu, Kerala, Karnataka, Andhra &amp; Telangana. Whether it's a one-way drop or a round trip, we've got you covered.</p>
            </div>
            <div class="cta-button-side">
                <a href="index.html#home" class="btn-premium-cta">
                    <i class="fa-solid fa-calendar-check"></i>
                    Book Online Now
                </a>
                <a href="tel:+919442173548" class="btn-premium-cta secondary-cta" style="margin-top:0.5rem; border:none; background:rgba(255,255,255,0.05);">
                    <i class="fa-solid fa-phone"></i>
                    +91 94421 73548
                </a>
                <p style="margin-top:1rem; font-size:0.9rem; color:var(--brand-cyan); font-weight:600;">
                    <i class="fa-solid fa-bolt"></i> Instant Booking Available
                </p>
            </div>
        </div>
    </section>



    <!-- Footer -->
    <footer class="modern-footer">
        <div class="footer-container">
            <div class="footer-section brand-section">
                <h2>KPS Travels</h2>
                <p>Premium Door-to-Door Outstation Travel Services across South India.</p>
                <div class="social-links">
                    <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" aria-label="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                </div>
            </div>

            <div class="footer-section links-section">
                <h3>Quick Links</h3>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li><a href="our-fleet.html">Our Fleet</a></li>
                    <li><a href="routes.html">Routes We Cover</a></li>
                    <li><a href="services.html">Our Services</a></li>
                    <li><a href="feedback.html">Feedback</a></li>
                </ul>
            </div>

            <div class="footer-section contact-section-footer">
                <h3>Contact Us</h3>
                <div class="footer-contact-item">
                    <div class="fc-text">
                        <p>No 27 Masaniyamman Nagar, Edayarpalayam, Coimbatore 641025.</p>
                    </div>
                </div>
                <div class="footer-contact-item">
                    <div class="fc-text">
                        <p><a href="tel:+919442173548">+91 94421 73548</a></p>
                        <p><a href="mailto:kiransakthivel71@gmail.com">kiransakthivel71@gmail.com</a></p>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2026 All Rights Reserved By KPS Tours &amp; Travels</p>
        </div>
    </footer>

    <!-- Floating Action Buttons -->
    <div class="floating-widgets">
        <a href="tel:+919442173548" class="fab phone-fab" aria-label="Call Us">
            <i class="fa-solid fa-phone"></i>
            <span class="fab-tooltip">Call Now</span>
        </a>
        <a href="https://wa.me/919442173548" target="_blank" class="fab whatsapp-fab" aria-label="WhatsApp Us">
            <i class="fa-brands fa-whatsapp"></i>
            <span class="fab-tooltip">WhatsApp</span>
        </a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script type="module" src="js/main.js?v=17"></script>
</body>

</html>
